# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, openai/.env.example, oidc/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=open-webui
PROJECT_NAME=${COMPOSE_PROJECT_NAME}

# Docker image
IMAGE=ghcr.io/open-webui/open-webui:main

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# WebUI secret key for session management
WEBUI_SECRET_KEY=B7qrb5MN9NOknfeKcwwO2Q==

DEFAULT_LOCALE=en

ENABLE_OPENAI_API=false
ENABLE_OLLAMA_API=false

ENABLE_EVALUATION_ARENA_MODELS=false
OFFLINE_MODE=false

DEFAULT_MODELS=anthropic/claude-sonnet-4.5:online

CHAT_STREAM_SPLIT_LARGE_CONTENT=true
CHAT_STREAM_RESPONSE_CHUNK_MAX_BUFFER_SIZE=10485760
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=8080
VIRTUAL_HOST=chat.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=chat.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# OpenAI API configuration (Optional)
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://openai.com/api/v1
OPENAI_API_KEY=your_openai_api_key
# OPENAI_API_BASE_URLS=http://host-one:11434;http://host-two:11434
OPENAI_API_BASE_URLS=
# OPENAI_API_KEYS=sk-124781258123;sk-4389759834759834
OPENAI_API_KEYS=

TASK_MODEL_EXTERNAL=deepseek/deepseek-chat-v3-0324:free
# Enable OAuth2/OIDC Login
ENABLE_OAUTH_SIGNUP=true

# Keycloak Client Information
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=<YOUR_COPIED_SECRET>

# OIDC Discovery Document URL
OPENID_PROVIDER_URL=http://localhost:9090/realms/openwebui/.well-known/openid-configuration

# (Optional) SSO Button Label
OAUTH_PROVIDER_NAME=Keycloak

# (Optional) OAuth Callback URL
OPENID_REDIRECT_URI=http://localhost:8080/oauth/oidc/callback

# (Optional) OAuth Groups
OAUTH_GROUPS_CLAIM=groups